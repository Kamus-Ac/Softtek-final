      "additionalProperties": false,
      "properties": {
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "schema_version": {
          "type": "string",
          "enum": [
            "1.0"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "mesa.desatendida"
          ]
        },
        "restaurant_id": {
          "type": "string",
          "format": "uuid"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "vision"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mesa_id": {
              "type": "string",
              "format": "uuid"
            },
            "desde": {
              "type": "string",
              "format": "date-time"
            },
            "duracion_seg": {
              "type": "integer",
              "minimum": 0
            },
            "severidad": {
              "type": "string",
              "enum": [
                "advertencia",
                "critica"
              ]
            }
          },
          "required": [
            "mesa_id",
            "desde",
            "duracion_seg",
            "severidad"
